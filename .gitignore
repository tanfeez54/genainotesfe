# Frontend .gitignore

# Dependencies
/node_modules
/.pnp
.pnp.*

# Next.js Build Outputs
/.next/
/out/
/build
/dist

# Environment Variables & Secrets (CRITICAL: Never commit to Git)
.env
.env.*
*.env
*.env.local
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Vercel
.vercel

# TypeScript & Cache
*.tsbuildinfo
next-env.d.ts
.eslintcache
.stylelintcache

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Testing & Coverage
/coverage

# OS & Editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
